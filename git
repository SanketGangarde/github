import java.util.*;
public class ClassRoom{

    public static void main(String[] args) {
        
  
    int val[] = {60,100,120};
    int weight[] = {10,20,30};
    int w = 50;

    double ratio[][] = new double[val.length][2];
    //0th column => indx; 1st column => ratio

    for(int i=0; i<val.length; i++){
        ratio[i][0] = i;
        ratio[i][1] = val[i]/(double)weight[i];
    }

    //ascending order
    Arrays.sort(ratio, Comparator.comparingDouble(o -> o[1]));

    int capacity = w;
    int finalVal = 0;

    //sort in decending
    for(int i=ratio.length-1; i>=0; i--){
        int indx = (int)ratio[i][0];
        if(capacity >= weight[indx]){ //include full item
            finalVal += val[indx];
            capacity -= weight[indx];

        }else{
            //include fractional item
            finalVal += (ratio[i][1] * capacity);
            capacity = 0;
            break;
        }
    }
    System.out.println("final val = "+ finalVal);

   }
}

public class DP{

    public static int  KnapSack01(int val[], int wt[],int W, int n){
        if(W == 0 || n == 0){
            return 0;
        }
        //reverse looping 
        if(wt[n-1] <= W){// valid Condition
         //include
         int ans1 = val[n-1] + KnapSack01(val,wt,W-wt[n-1], n-1);
         //exclude
         int ans2 = KnapSack01(val,wt,W, n-1);
         return Math.max(ans1, ans2);
        }else{//not valid
          return KnapSack01(val, wt, W, n-1);
        }
    }
    public static void main(String[] args) {
        int val[] = { 15,14,10,45,30};
        int wt[] = { 2  , 5, 1, 3, 4};
        int W = 7;

        System.out.println(KnapSack01(val, wt, W, val.length));
        

    }
}
